<Window x:Class="LabOH.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Билетная • Экзаменационные билеты" Width="1000" Height="700"
 MinWidth="860" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="#F2F4F8" FontFamily="Segoe UI" Foreground="#172338"
 PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="TextBox">
   <Setter Property="FontSize" Value="18"/><Setter Property="Padding" Value="14,12"/>
   <Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#D9E0EA"/>
   <Setter Property="Margin" Value="0,8,0,20"/><Setter Property="MaxLength" Value="150"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="20,14"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="#2859DB"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#89ADFF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,28">
   <TextBlock Text="БИЛЕТНАЯ / ЭКЗАМЕН" Foreground="#2859DB" FontSize="12" FontWeight="Bold"/>
   <TextBlock Text="Ваш билет к экзамену" FontSize="32" FontWeight="Bold" Margin="0,8,0,5"/>
   <TextBlock Text="Введите данные студента — мы выберем билет и сохраним его в журнал." Foreground="#65718A" FontSize="14"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="18" Padding="28">
    <StackPanel>
     <TextBlock Text="01 / ДАННЫЕ СТУДЕНТА" Foreground="#65718A" FontSize="12" Margin="0,0,0,24"/>
     <TextBlock Text="Фамилия" FontWeight="SemiBold"/>
     <TextBox x:Name="LastNameBox" AutomationProperties.Name="Фамилия"/>
     <TextBlock Text="Имя" FontWeight="SemiBold"/>
     <TextBox x:Name="FirstNameBox" AutomationProperties.Name="Имя"/>
     <Button x:Name="GenerateButton" Content="Получить билет →" Click="Generate_Click" IsDefault="True"/>
     <TextBlock x:Name="StatusText" Text="Enter — получить билет · Esc — выход" TextWrapping="Wrap" Foreground="#65718A" Margin="0,16,0,0" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="#172B4D" CornerRadius="18" Padding="28">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="02 / ВАШ ЭКЗАМЕНАЦИОННЫЙ БИЛЕТ" Foreground="#AEC0E2" FontSize="11" TextWrapping="Wrap"/>
     <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <TextBlock x:Name="TicketText" Text="—" FontSize="100" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
      <TextBlock x:Name="StudentText" Text="Здесь появится ваш номер" TextWrapping="Wrap" TextAlignment="Center" Foreground="#D3DFF4" FontSize="17"/>
      <TextBlock x:Name="SavedText" Text="Случайный выбор от 1 до 20" TextWrapping="Wrap" TextAlignment="Center" Foreground="#91A9D1" Margin="0,12,0,0"/>
     </StackPanel>
     <Button Grid.Row="2" x:Name="NextButton" Content="Следующий студент" Background="#2C4264" Click="Next_Click" IsEnabled="False"/>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#E7ECF4" CornerRadius="12" Padding="18" Margin="0,24,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
     <TextBlock Text="EXCEL-ЖУРНАЛ" FontSize="11" FontWeight="Bold" Foreground="#52627B"/>
     <TextBlock x:Name="JournalPathText" FontSize="12" Foreground="#52627B" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <Button Grid.Column="1" Content="Открыть папку" Background="White" Foreground="#2859DB" Click="OpenFolder_Click"/>
   </Grid>
  </Border>
 </Grid>
</Window>
